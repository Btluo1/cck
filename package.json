{
	"name": "qodercck",
	"version": "1.3.13",
	"description": "CCK 账号管理器客户端（开源版：账号管理 + 额度查询）",
	"main": "main.js",
	"scripts": {
		"start": "electron .",
		"dev": "electron . --dev",
		"build": "electron-builder --win --x64 --publish never",
		"test": "node test/test-custom-accounts.js"
	},
	"devDependencies": {
		"electron": "^33.0.0",
		"electron-builder": "^25.0.0"
	},
	"dependencies": {
		"@primno/dpapi": "^2.0.1",
		"sql.js": "^1.13.0"
	},
	"build": {
		"appId": "com.cck.manager",
		"productName": "CCK 账号管理器",
		"npmRebuild": false,
		"directories": {
			"output": "dist"
		},
		"files": [
			"main.js",
			"preload.js",
			"lib/**/*",
			"renderer/**/*",
			"assets/icon.ico"
		],
		"win": {
			"target": "nsis",
			"icon": "assets/icon.ico",
			"artifactName": "CCK-Setup-${version}.exe"
		},
		"nsis": {
			"oneClick": false,
			"allowToChangeInstallationDirectory": true,
			"createDesktopShortcut": true,
			"createStartMenuShortcut": true,
			"shortcutName": "CCK 账号管理器"
		}
	}
}
